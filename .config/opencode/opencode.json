{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "which *": "allow",
      "cat *": "allow",
      "npm install *": "deny",
      "pip install *": "deny",
      "apt-get install *": "deny",
      "brew install *": "deny",
      "cargo install *": "deny",
      "go install *": "deny"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
